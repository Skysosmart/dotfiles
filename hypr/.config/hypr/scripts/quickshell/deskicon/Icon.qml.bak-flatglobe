import QtQuick
import Quickshell
import Quickshell.Io
import Quickshell.Wayland
import Qt5Compat.GraphicalEffects

// Desktop Arch emblem (white + wallpaper-adaptive accent glow) that, when clicked,
// opens a "globe / orbit" app launcher: apps orbit a central globe, scroll/drag to
// rotate, click to launch. One standalone instance handles both.
ShellRoot {
    id: root

    property color accent: "#89b4fa"
    property bool launcherOpen: true
    property var apps: []

    function launch(execStr) {
        Quickshell.execDetached(["hyprctl", "dispatch", "exec", "--", execStr]);
        root.launcherOpen = false;
    }

    // Live accent (material primary), regenerated from each wallpaper by matugen.
    Process {
        id: themeReader
        command: ["cat", Quickshell.env("HOME") + "/.config/hypr/scripts/quickshell/qs_colors.json"]
        stdout: StdioCollector {
            onStreamFinished: {
                try { let c = JSON.parse(this.text.trim()); if (c.blue) root.accent = c.blue; } catch (e) {}
            }
        }
    }
    Timer { interval: 1000; running: true; repeat: true; triggeredOnStart: true; onTriggered: themeReader.running = true }

    // App list (reuses the existing launcher's fetcher).
    Process {
        id: appFetcher
        running: true
        command: ["bash", "-c", "python3 " + Quickshell.env("HOME") + "/.config/hypr/scripts/quickshell/applauncher/app_fetcher.py"]
        stdout: StdioCollector {
            onStreamFinished: {
                try { if (this.text && this.text.trim().length) root.apps = JSON.parse(this.text); } catch (e) {}
            }
        }
    }

    // ---------------------------------------------------------------- the logo
    Variants {
        model: Quickshell.screens
        delegate: Component {
            PanelWindow {
                id: logoWin
                required property var modelData
                screen: modelData

                WlrLayershell.namespace: "desk-icon"
                WlrLayershell.layer: WlrLayer.Bottom
                exclusionMode: ExclusionMode.Ignore
                color: "transparent"
                anchors { top: true; bottom: true; left: true; right: true }

                property int glyphSize: Math.round(logoWin.height * 0.30)

                // Only the glyph area is clickable; the rest stays click-through.
                mask: Region { item: clickZone }

                property real breathe: 0.9
                SequentialAnimation on breathe {
                    running: true; loops: Animation.Infinite
                    NumberAnimation { from: 0.82; to: 1.0; duration: 3500; easing.type: Easing.InOutSine }
                    NumberAnimation { from: 1.0; to: 0.82; duration: 3500; easing.type: Easing.InOutSine }
                }

                // wide soft accent wash
                Text {
                    anchors.centerIn: parent
                    text: ""; font.family: "JetBrainsMono Nerd Font Mono"
                    font.pixelSize: logoWin.glyphSize; color: root.accent
                    scale: 1.14; opacity: logoWin.breathe * 0.28; z: -2
                }
                // tight accent glow
                Glow {
                    anchors.fill: whiteGlyph; source: whiteGlyph; color: root.accent
                    radius: Math.round(logoWin.glyphSize * 0.10); samples: 33; spread: 0.25
                    opacity: logoWin.breathe; z: -1
                }
                // white arch on top
                Text {
                    id: whiteGlyph
                    anchors.centerIn: parent
                    text: ""; font.family: "JetBrainsMono Nerd Font Mono"
                    font.pixelSize: logoWin.glyphSize; padding: Math.round(logoWin.glyphSize * 0.18)
                    color: "white"; opacity: logoWin.breathe
                }
                // click target over the glyph
                Item {
                    id: clickZone
                    anchors.centerIn: parent
                    width: logoWin.glyphSize * 1.1; height: logoWin.glyphSize
                    MouseArea {
                        anchors.fill: parent
                        cursorShape: Qt.PointingHandCursor
                        onClicked: root.launcherOpen = true
                    }
                }
            }
        }
    }

    // ------------------------------------------------------- the globe launcher
    Variants {
        model: Quickshell.screens
        delegate: Component {
            PanelWindow {
                id: gWin
                required property var modelData
                screen: modelData

                WlrLayershell.namespace: "desk-globe"
                WlrLayershell.layer: WlrLayer.Overlay
                WlrLayershell.keyboardFocus: WlrKeyboardFocus.None
                exclusionMode: ExclusionMode.Ignore
                focusable: false
                color: "transparent"
                anchors { top: true; bottom: true; left: true; right: true }
                visible: true

                // Always mapped (reliable); input captured only when open,
                // otherwise the empty mask makes it fully click-through.
                Item { id: fullArea; anchors.fill: parent }
                Item { id: noArea; width: 0; height: 0 }
                mask: Region { item: root.launcherOpen ? fullArea : noArea }

                property int count: root.apps.length
                property real rot: 0
                Behavior on rot { NumberAnimation { duration: 220; easing.type: Easing.OutCubic } }

                property real cx: width / 2
                property real cy: height / 2
                property real rx: height * 0.34
                property real ry: height * 0.27
                property real baseIcon: height * 0.052

                // animate the whole thing opening
                property real reveal: root.launcherOpen ? 1 : 0
                Behavior on reveal { NumberAnimation { duration: 260; easing.type: Easing.OutCubic } }

                // dim backdrop + interactions (wheel/drag rotate, empty click closes)
                Rectangle {
                    anchors.fill: parent
                    color: "#000000"
                    opacity: gWin.reveal * 0.55
                }
                MouseArea {
                    id: backdrop
                    anchors.fill: parent
                    property real lastX: 0
                    property bool dragged: false
                    onPressed: function(m) { lastX = m.x; dragged = false }
                    onPositionChanged: function(m) {
                        if (pressed) {
                            var d = m.x - lastX;
                            if (Math.abs(d) > 2) dragged = true;
                            gWin.rot += d * 0.006; lastX = m.x;
                        }
                    }
                    onReleased: function(m) { if (!dragged) root.launcherOpen = false }
                    onWheel: function(w) {
                        var step = 2 * Math.PI / Math.max(gWin.count, 1);
                        gWin.rot += (w.angleDelta.y > 0 ? 1 : -1) * step;
                    }
                }

                // keyboard: Esc closes
                Item {
                    anchors.fill: parent
                    focus: root.launcherOpen
                    Keys.onEscapePressed: root.launcherOpen = false
                }

                // central globe
                Item {
                    anchors.centerIn: parent
                    opacity: gWin.reveal
                    scale: 0.85 + 0.15 * gWin.reveal
                    Glow {
                        anchors.fill: globe; source: globe; color: root.accent
                        radius: Math.round(gWin.height * 0.02); samples: 33; spread: 0.3
                    }
                    Text {
                        id: globe
                        text: ""; font.family: "JetBrainsMono Nerd Font Mono"
                        font.pixelSize: Math.round(gWin.height * 0.17); color: "white"
                        SequentialAnimation on opacity {
                            running: gWin.visible; loops: Animation.Infinite
                            NumberAnimation { from: 0.8; to: 1.0; duration: 2600; easing.type: Easing.InOutSine }
                            NumberAnimation { from: 1.0; to: 0.8; duration: 2600; easing.type: Easing.InOutSine }
                        }
                    }
                }

                // orbiting apps
                Item {
                    id: orbit
                    anchors.fill: parent
                    Repeater {
                        model: root.apps
                        delegate: Item {
                            id: node
                            required property var modelData
                            required property int index
                            property real theta: index * (2 * Math.PI / Math.max(gWin.count, 1)) - gWin.rot
                            property real depth: Math.cos(theta)
                            property real f: (depth + 1) / 2          // 0 back .. 1 front
                            width: gWin.baseIcon; height: gWin.baseIcon
                            x: gWin.cx + gWin.rx * Math.sin(theta) - width / 2
                            y: gWin.cy + gWin.ry * depth - height / 2
                            z: Math.round(f * 100)
                            scale: (0.6 + 0.6 * f) * gWin.reveal
                            opacity: (0.35 + 0.65 * f) * gWin.reveal

                            Image {
                                id: ico
                                anchors.top: parent.top; anchors.horizontalCenter: parent.horizontalCenter
                                width: parent.width; height: parent.width
                                asynchronous: true; fillMode: Image.PreserveAspectFit
                                sourceSize.width: 96; sourceSize.height: 96
                                source: {
                                    var ic = node.modelData.icon || "";
                                    if (!ic) return "image://icon/application-x-executable";
                                    return ic.charAt(0) === "/" ? "file://" + ic : "image://icon/" + ic;
                                }
                                onStatusChanged: if (status === Image.Error) source = "image://icon/application-x-executable"
                            }
                            // label only for the front-most apps
                            Text {
                                anchors.top: ico.bottom; anchors.topMargin: 4
                                anchors.horizontalCenter: parent.horizontalCenter
                                width: gWin.baseIcon * 2.4; horizontalAlignment: Text.AlignHCenter
                                elide: Text.ElideRight; maximumLineCount: 1
                                text: node.modelData.name || ""
                                color: "white"; font.family: "JetBrains Mono"; font.pixelSize: 13
                                visible: node.f > 0.62
                                style: Text.Outline; styleColor: "#000000"
                            }
                            MouseArea {
                                anchors.fill: parent
                                cursorShape: Qt.PointingHandCursor
                                onClicked: root.launch(node.modelData.exec)
                            }
                        }
                    }
                }

                // hint
                Text {
                    anchors.horizontalCenter: parent.horizontalCenter
                    anchors.bottom: parent.bottom; anchors.bottomMargin: Math.round(gWin.height * 0.06)
                    text: "scroll or drag to spin   ·   click to launch   ·   esc to close"
                    color: "white"; opacity: gWin.reveal * 0.6
                    font.family: "JetBrains Mono"; font.pixelSize: 13
                }
            }
        }
    }
}
