{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "small",
    "color": {
      "1": "#1e66f5",
      "2": "#fe640b",
      "3": "#40a02b"
    },
    "padding": {
      "top": 1,
      "left": 2,
      "right": 3
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "separator": "#4c4f69"
    }
  },
  "modules": [
    "break",
    {
      "type": "title",
      "format": "{1}",
      "color": {
        "user": "#1e66f5"
      }
    },
    "break",
    {
      "type": "os",
      "key": "󱄅 os ",
      "keyColor": "#1e66f5"
    },
    {
      "type": "cpu",
      "key": " cpu",
      "keyColor": "#fe640b"
    },
    {
      "type": "memory",
      "key": "󰘚 ram",
      "keyColor": "#40a02b"
    },
    {
      "type": "shell",
      "key": " sh ",
      "keyColor": "#8839ef"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
