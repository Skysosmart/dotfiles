# Never commit secrets or local state
*.log
*.bak
*.tmp
*~

# Caches / state that may slip into copied config dirs
**/cache/
**/Cache/
**/.cache/
**/logs/
**/*.sock

# Large vendored help screenshots (re-fetched by the shell)
hypr/.config/hypr/scripts/quickshell/guide/previews/

# Anything that looks like a credential (defense in depth)
*.pem
*.key
*id_rsa*
*credentials*
*service_account*

# Serpantinum bundled binaries (~160MB of fonts/sounds; ship with the upstream installer)
serpantinum/.local/share/serpantinum/src/assets/fonts/
serpantinum/.local/share/serpantinum/src/assets/sounds/
