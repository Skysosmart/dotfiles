import QtQuick
import Quickshell
import Quickshell.Io
import Quickshell.Wayland
import Qt5Compat.GraphicalEffects

// Desktop Arch emblem (white + wallpaper-adaptive accent glow). Clicking it opens a
// 3D globe launcher: a spinning wireframe sphere with apps on independent random
// orbits in 3D (passing in front of and behind the globe). Hover pauses the orbit
// so you can click; click an app to launch, click empty space to close.
ShellRoot {
    id: root

    property color accent: "#89b4fa"
    property bool launcherOpen: false
    property var apps: []

    function launch(execStr) {
        Quickshell.execDetached(["hyprctl", "dispatch", "exec", "--", execStr]);
        root.launcherOpen = false;
    }

    Process {
        id: themeReader
        command: ["cat", Quickshell.env("HOME") + "/.config/hypr/scripts/quickshell/qs_colors.json"]
        stdout: StdioCollector { onStreamFinished: { try { let c = JSON.parse(this.text.trim()); if (c.blue) root.accent = c.blue; } catch (e) {} } }
    }
    Timer { interval: 1000; running: true; repeat: true; triggeredOnStart: true; onTriggered: themeReader.running = true }

    Process {
        id: appFetcher
        running: true
        command: ["bash", "-c", "python3 " + Quickshell.env("HOME") + "/.config/hypr/scripts/quickshell/applauncher/app_fetcher.py"]
        stdout: StdioCollector {
            onStreamFinished: {
                try {
                    if (this.text && this.text.trim().length) {
                        var list = JSON.parse(this.text);
                        // cap for a smooth orbit; sample across the list so it is not just A-F
                        if (list.length > 56) {
                            var step = list.length / 56, out = [];
                            for (var i = 0; i < 56; i++) out.push(list[Math.floor(i * step)]);
                            list = out;
                        }
                        root.apps = list;
                    }
                } catch (e) {}
            }
        }
    }

    // ---------------------------------------------------------------- the logo
    Variants {
        model: Quickshell.screens
        delegate: Component {
            PanelWindow {
                id: logoWin
                required property var modelData
                screen: modelData
                WlrLayershell.namespace: "desk-icon"
                WlrLayershell.layer: WlrLayer.Bottom
                exclusionMode: ExclusionMode.Ignore
                color: "transparent"
                anchors { top: true; bottom: true; left: true; right: true }

                property int glyphSize: Math.round(logoWin.height * 0.30)
                mask: Region { item: clickZone }

                property real breathe: 0.9
                SequentialAnimation on breathe {
                    running: true; loops: Animation.Infinite
                    NumberAnimation { from: 0.82; to: 1.0; duration: 3500; easing.type: Easing.InOutSine }
                    NumberAnimation { from: 1.0; to: 0.82; duration: 3500; easing.type: Easing.InOutSine }
                }

                Text {
                    anchors.centerIn: parent; text: ""; font.family: "JetBrainsMono Nerd Font Mono"
                    font.pixelSize: logoWin.glyphSize; color: root.accent; scale: 1.14
                    opacity: logoWin.breathe * 0.28; z: -2
                }
                Glow {
                    anchors.fill: whiteGlyph; source: whiteGlyph; color: root.accent
                    radius: Math.round(logoWin.glyphSize * 0.10); samples: 33; spread: 0.25
                    opacity: logoWin.breathe; z: -1
                }
                Text {
                    id: whiteGlyph; anchors.centerIn: parent; text: ""
                    font.family: "JetBrainsMono Nerd Font Mono"; font.pixelSize: logoWin.glyphSize
                    padding: Math.round(logoWin.glyphSize * 0.18); color: "white"; opacity: logoWin.breathe
                }
                Item {
                    id: clickZone; anchors.centerIn: parent
                    width: logoWin.glyphSize * 1.1; height: logoWin.glyphSize
                    MouseArea { anchors.fill: parent; cursorShape: Qt.PointingHandCursor; onClicked: root.launcherOpen = true }
                }
            }
        }
    }

    // ------------------------------------------------------- the globe launcher
    Variants {
        model: Quickshell.screens
        delegate: Component {
            PanelWindow {
                id: gWin
                required property var modelData
                screen: modelData
                WlrLayershell.namespace: "desk-globe"
                WlrLayershell.layer: WlrLayer.Overlay
                WlrLayershell.keyboardFocus: WlrKeyboardFocus.None
                exclusionMode: ExclusionMode.Ignore
                focusable: false
                color: "transparent"
                anchors { top: true; bottom: true; left: true; right: true }
                visible: true

                // Always mapped; input only when open (else fully click-through).
                Item { id: fullArea; anchors.fill: parent }
                Item { id: noArea; width: 0; height: 0 }
                mask: Region { item: root.launcherOpen ? fullArea : noArea }

                property real cx: width / 2
                property real cy: height / 2
                property real globeR: height * 0.085
                property real baseIcon: height * 0.05
                property int hoverCount: 0
                property real t: 0          // ever-increasing orbital time
                property real viewSpin: 0   // drag to rotate the whole system

                property real reveal: root.launcherOpen ? 1 : 0
                Behavior on reveal { NumberAnimation { duration: 280; easing.type: Easing.OutCubic } }

                // Apps stay still at their random 3D positions (t is fixed).
                // Drag still rotates the whole system via viewSpin.

                // dim backdrop (also closes on empty click, drag to spin the view)
                Rectangle { anchors.fill: parent; color: "#05060a"; opacity: gWin.reveal * 0.84; z: -100000 }
                MouseArea {
                    anchors.fill: parent; z: -100000
                    property real lastX: 0
                    property bool dragged: false
                    onPressed: function(m) { lastX = m.x; dragged = false }
                    onPositionChanged: function(m) {
                        if (pressed) { var d = m.x - lastX; if (Math.abs(d) > 2) dragged = true; gWin.viewSpin += d * 0.005; lastX = m.x; }
                    }
                    onReleased: function(m) { if (!dragged) root.launcherOpen = false }
                    onWheel: function(w) { gWin.viewSpin += (w.angleDelta.y > 0 ? 1 : -1) * 0.25 }
                }

                // ----- 3D spinning wireframe globe -----
                Item {
                    id: globe
                    anchors.centerIn: parent
                    width: gWin.globeR * 2.4; height: gWin.globeR * 2.4
                    z: 0
                    opacity: gWin.reveal
                    scale: 0.85 + 0.15 * gWin.reveal

                    Glow { anchors.fill: sphere; source: sphere; color: root.accent; radius: 26; samples: 41; spread: 0.2 }

                    Canvas {
                        id: sphere
                        anchors.fill: parent
                        property real spin: 0
                        onSpinChanged: requestPaint()
                        onPaint: {
                            var ctx = getContext('2d');
                            ctx.reset();
                            var R = gWin.globeR;
                            var ox = width / 2, oy = height / 2;
                            // shaded sphere body
                            var g = ctx.createRadialGradient(ox - R * 0.35, oy - R * 0.4, R * 0.1, ox, oy, R);
                            g.addColorStop(0, Qt.alpha(Qt.lighter(root.accent, 1.4), 0.55));
                            g.addColorStop(0.7, Qt.alpha(root.accent, 0.22));
                            g.addColorStop(1, Qt.alpha(Qt.darker(root.accent, 1.7), 0.10));
                            ctx.beginPath(); ctx.arc(ox, oy, R, 0, 2 * Math.PI); ctx.fillStyle = g; ctx.fill();
                            // latitude rings (parallels)
                            for (var li = -2; li <= 2; li++) {
                                var lat = li * (Math.PI / 6);
                                var py = oy - R * Math.sin(lat);
                                var pr = R * Math.cos(lat);
                                ctx.beginPath();
                                ctx.ellipse(ox - pr, py - pr * 0.26, pr * 2, pr * 0.52);
                                ctx.lineWidth = 1.2; ctx.strokeStyle = Qt.alpha(root.accent, 0.32); ctx.stroke();
                            }
                            // longitude meridians (animated -> spinning globe)
                            for (var mi = 0; mi < 6; mi++) {
                                var phi = sphere.spin + mi * (Math.PI / 6);
                                var rx = Math.abs(R * Math.cos(phi));
                                ctx.beginPath();
                                ctx.ellipse(ox - rx, oy - R, rx * 2, R * 2);
                                ctx.lineWidth = 1.2;
                                ctx.strokeStyle = Qt.alpha("white", 0.10 + 0.28 * Math.abs(Math.sin(phi)));
                                ctx.stroke();
                            }
                            // rim
                            ctx.beginPath(); ctx.arc(ox, oy, R, 0, 2 * Math.PI);
                            ctx.lineWidth = 1.6; ctx.strokeStyle = Qt.alpha("white", 0.55); ctx.stroke();
                        }
                        NumberAnimation on spin {
                            running: gWin.reveal > 0.01; from: 0; to: 2 * Math.PI
                            duration: 16000; loops: Animation.Infinite
                        }
                        Connections { target: root; function onAccentChanged() { sphere.requestPaint() } }
                    }
                }

                // ----- apps on independent random 3D orbits -----
                Repeater {
                    model: root.apps
                    delegate: Item {
                        id: node
                        required property var modelData
                        required property int index
                        // stable random orbit parameters (evaluated once)
                        property real phase: Math.random() * 6.283
                        property real speed: 0.6 + Math.random() * 1.15
                        property real inc: (Math.random() - 0.5) * 1.8
                        property real orient: Math.random() * 6.283
                        property real orad: gWin.globeR * (2.4 + Math.random() * 2.7)
                        property real dir: Math.random() < 0.5 ? 1 : -1
                        property bool hovered: hov.containsMouse

                        property real a: node.dir * gWin.t * node.speed + node.phase
                        property real x1: node.orad * Math.cos(node.a)
                        property real y1: node.orad * Math.sin(node.a) * Math.cos(node.inc)
                        property real z1: node.orad * Math.sin(node.a) * Math.sin(node.inc)
                        property real rr: node.orient + gWin.viewSpin
                        property real x2: node.x1 * Math.cos(node.rr) + node.z1 * Math.sin(node.rr)
                        property real z2: -node.x1 * Math.sin(node.rr) + node.z1 * Math.cos(node.rr)
                        property real depth: node.z2 / node.orad
                        property real f: (node.depth + 1) / 2

                        width: gWin.baseIcon; height: gWin.baseIcon
                        x: gWin.cx + node.x2 - width / 2
                        y: gWin.cy - node.y1 - height / 2
                        z: Math.round(node.depth * 1000)
                        scale: (0.5 + 0.55 * node.f) * (node.hovered ? 1.4 : 1.0) * gWin.reveal
                        opacity: (0.28 + 0.72 * node.f) * gWin.reveal
                        Behavior on scale { NumberAnimation { duration: 140; easing.type: Easing.OutBack } }

                        property string iconName: node.modelData.icon || ""
                        property bool broken: node.iconName === ""

                        Image {
                            id: ico
                            anchors.fill: parent
                            visible: !node.broken
                            asynchronous: true; fillMode: Image.PreserveAspectFit
                            sourceSize.width: 96; sourceSize.height: 96
                            source: node.broken ? "" : (node.iconName.charAt(0) === "/" ? "file://" + node.iconName : "image://icon/" + node.iconName)
                            onStatusChanged: if (status === Image.Error) node.broken = true
                            layer.enabled: node.hovered
                            layer.effect: Glow { color: root.accent; radius: 18; samples: 25; spread: 0.4 }
                        }
                        // clean fallback tile for apps with no themed icon
                        Rectangle {
                            anchors.fill: parent; visible: node.broken
                            radius: width * 0.24
                            gradient: Gradient {
                                GradientStop { position: 0.0; color: Qt.lighter(root.accent, 1.15) }
                                GradientStop { position: 1.0; color: Qt.darker(root.accent, 1.3) }
                            }
                            Text {
                                anchors.centerIn: parent
                                text: (node.modelData.name || "?").charAt(0).toUpperCase()
                                color: "white"; font.bold: true; font.family: "JetBrains Mono"
                                font.pixelSize: parent.width * 0.5
                            }
                        }
                        Rectangle {
                            visible: node.hovered
                            anchors.horizontalCenter: parent.horizontalCenter
                            anchors.top: parent.bottom; anchors.topMargin: 6
                            radius: 6; color: Qt.alpha("#000000", 0.72)
                            implicitWidth: lbl.implicitWidth + 16; implicitHeight: lbl.implicitHeight + 8
                            Text {
                                id: lbl; anchors.centerIn: parent; text: node.modelData.name || ""
                                color: "white"; font.family: "JetBrains Mono"; font.pixelSize: 13
                            }
                        }
                        MouseArea {
                            id: hov; anchors.fill: parent; hoverEnabled: true
                            cursorShape: Qt.PointingHandCursor
                            onEntered: gWin.hoverCount++
                            onExited: gWin.hoverCount--
                            onClicked: root.launch(node.modelData.exec)
                        }
                    }
                }

                // hint
                Text {
                    anchors.horizontalCenter: parent.horizontalCenter
                    anchors.bottom: parent.bottom; anchors.bottomMargin: Math.round(gWin.height * 0.06)
                    text: "hover to pause & aim  ·  click to launch  ·  drag to spin  ·  click empty to close"
                    color: "white"; opacity: gWin.reveal * 0.55
                    font.family: "JetBrains Mono"; font.pixelSize: 13
                }
            }
        }
    }
}
