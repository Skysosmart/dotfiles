hl.env("NIXOS_OZONE_WL", "1")
hl.env("XDG_PICTURES_DIR", "{{XDG_PICTURES_DIR}}")
hl.env("XDG_VIDEOS_DIR", "{{XDG_VIDEOS_DIR}}")
hl.env("WALLPAPER_DIR", "{{WALLPAPER_DIR}}")
hl.env("SCRIPT_DIR", "{{SCRIPT_DIR}}")
hl.env("QT_QPA_PLATFORMTHEME", "qt6ct")

-- Cursor: Bibata Modern Ice, installed user-local in ~/.local/share/icons.
-- Hyprland reads these at launch; gsettings + ~/.icons/default cover GTK/Qt/XWayland.
-- XCursor only: the hyprcursor converter needs xcur2png (AUR), which is not installed.
hl.env("XCURSOR_THEME", "Bibata-Modern-Ice")
hl.env("XCURSOR_SIZE", "28")

-- Hardware Injections
hl.env("ELECTRON_OZONE_PLATFORM_HINT", "auto")

-- GPU: clients render on the SAME gpu as the compositor (AMD 680M / card1).
--
-- Hyprland's renderer is pinned to card1 (amdgpu) -- see aquamarine's
-- "CDRMRenderer(drm): Using device /dev/dri/card1". Previously this file also set
-- __NV_PRIME_RENDER_OFFLOAD / __GLX_VENDOR_LIBRARY_NAME=nvidia, which forced every
-- GL client onto the RTX 4050 instead. Each client buffer then had to cross
-- NVIDIA -> AMD to reach the screen, and that cross-gpu EGL path is broken on this
-- machine: black windows, flicker, corruption. The per-app wrappers in ~/.local/bin
-- (vesktop, spotify) exist purely to unset those vars again -- they were patching
-- this default one app at a time.
--
-- To run something ON the dGPU (games), use: nvidia-run <cmd>
hl.env("__GL_GSYNC_ALLOWED", "0")
hl.env("__GL_VRR_ALLOWED", "0")
hl.env("__GL_SHADER_DISK_CACHE", "1")
hl.env("__GL_SHADER_DISK_CACHE_PATH", "/home/zaru/.cache/nvidia")
hl.env("LIBVA_DRIVER_NAME", "radeonsi")
{{HARDWARE_ENV}}
